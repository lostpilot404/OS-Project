{
  "name": "workload_aware_q_learning_scheduling",
  "scheduler": {
    "round_robin_quantum": 4,
    "switching_cost": 0,
    "lower_priority_number_is_higher_priority": true
  },
  "workload_families": [
    {
      "name": "short_batch",
      "description": "Short-job dominated, batch release: 15 jobs of 1-4 time units, all released together.",
      "num_processes": 15,
      "burst_distribution": "uniform",
      "burst_time_min": 1,
      "burst_time_max": 4,
      "short_burst_max": 5,
      "short_burst_fraction": 0.7,
      "long_burst_min": 0,
      "arrival_pattern": "uniform",
      "arrival_window": 0,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "uniform",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    },
    {
      "name": "short_stream",
      "description": "Short-job dominated, staggered release: 15 jobs of 1-4 time units arriving within a 30-unit window (no long jobs).",
      "num_processes": 15,
      "burst_distribution": "uniform",
      "burst_time_min": 1,
      "burst_time_max": 4,
      "short_burst_max": 5,
      "short_burst_fraction": 0.7,
      "long_burst_min": 0,
      "arrival_pattern": "uniform",
      "arrival_window": 30,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "uniform",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    },
    {
      "name": "long_batch",
      "description": "Long-job dominated, batch release: 15 jobs of 20-50 time units, all released together.",
      "num_processes": 15,
      "burst_distribution": "uniform",
      "burst_time_min": 20,
      "burst_time_max": 50,
      "short_burst_max": 5,
      "short_burst_fraction": 0.7,
      "long_burst_min": 0,
      "arrival_pattern": "uniform",
      "arrival_window": 0,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "uniform",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    },
    {
      "name": "interactive",
      "description": "Interactive/response-sensitive: a small batch of long background jobs (60-100 units) released at the head of the window plus a stream of 18 very short interactive jobs (1-2 units) over 50 time units.",
      "num_processes": 20,
      "burst_distribution": "bimodal",
      "burst_time_min": 1,
      "burst_time_max": 100,
      "short_burst_max": 2,
      "short_burst_fraction": 0.9,
      "long_burst_min": 60,
      "arrival_pattern": "batch_head",
      "arrival_window": 50,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "uniform",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    },
    {
      "name": "interactive_sparse",
      "description": "Interactive with a sparser arrival stream: the same job mix as 'interactive' but the short jobs arrive over 110 time units (lighter load, slower interactive traffic).",
      "num_processes": 20,
      "burst_distribution": "bimodal",
      "burst_time_min": 1,
      "burst_time_max": 100,
      "short_burst_max": 2,
      "short_burst_fraction": 0.9,
      "long_burst_min": 60,
      "arrival_pattern": "batch_head",
      "arrival_window": 110,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "uniform",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    },
    {
      "name": "priority_aligned",
      "description": "Priority-sensitive with importance aligned to job size: uniform bursts 1-50, and the shortest jobs carry the highest priority (priority assigned by burst rank).",
      "num_processes": 15,
      "burst_distribution": "uniform",
      "burst_time_min": 1,
      "burst_time_max": 50,
      "short_burst_max": 5,
      "short_burst_fraction": 0.7,
      "long_burst_min": 0,
      "arrival_pattern": "uniform",
      "arrival_window": 20,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "burst_aligned",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    },
    {
      "name": "priority_skewed",
      "description": "Priority-sensitive with skewed priority labels uncorrelated with job size: uniform bursts 1-50 and 70% of the priorities in the band 1-2.",
      "num_processes": 15,
      "burst_distribution": "uniform",
      "burst_time_min": 1,
      "burst_time_max": 50,
      "short_burst_max": 5,
      "short_burst_fraction": 0.7,
      "long_burst_min": 0,
      "arrival_pattern": "uniform",
      "arrival_window": 20,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "high_priority_skewed",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    },
    {
      "name": "quantum_sensitive",
      "description": "Quantum-sensitive/preemption-heavy: 20 jobs of 2-12 time units straddling the Round-Robin quantum (4), arriving within a 30-unit window; preemption is frequent and costly.",
      "num_processes": 20,
      "burst_distribution": "uniform",
      "burst_time_min": 2,
      "burst_time_max": 12,
      "short_burst_max": 5,
      "short_burst_fraction": 0.7,
      "long_burst_min": 0,
      "arrival_pattern": "uniform",
      "arrival_window": 30,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "uniform",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    },
    {
      "name": "mixed",
      "description": "Mixed: 15 jobs with bursts uniform over the full 1-50 range, arriving within a 20-unit window.",
      "num_processes": 15,
      "burst_distribution": "uniform",
      "burst_time_min": 1,
      "burst_time_max": 50,
      "short_burst_max": 5,
      "short_burst_fraction": 0.7,
      "long_burst_min": 0,
      "arrival_pattern": "uniform",
      "arrival_window": 20,
      "head_window": 2,
      "arrival_rate": 0.5,
      "priority_pattern": "uniform",
      "priority_min": 1,
      "priority_max": 5,
      "high_priority_cutoff": 2,
      "high_priority_fraction": 0.7
    }
  ],
  "state": {
    "state_variables": [
      "burst_profile",
      "burst_dispersion",
      "long_job_share",
      "arrival_concentration",
      "offered_load",
      "priority_spread",
      "priority_burst_alignment"
    ],
    "bins_per_variable": 3,
    "n_states": 2187,
    "burst_profile_range": [
      1.0,
      100.0
    ],
    "burst_dispersion_range": [
      0.0,
      3.0
    ],
    "long_job_share_range": [
      0.0,
      1.0
    ],
    "arrival_concentration_range": [
      0.0,
      1.0
    ],
    "offered_load_range": [
      0.5,
      60.0
    ],
    "priority_spread_range": [
      0.0,
      2.0
    ],
    "priority_burst_alignment_range": [
      -1.0,
      1.0
    ],
    "long_burst_threshold": 16
  },
  "reward": {
    "weight_waiting_time": 0.3,
    "weight_turnaround_time": 0.25,
    "weight_response_time": 0.2,
    "weight_context_switches": 0.1,
    "weight_cpu_utilization": 0.075,
    "weight_throughput": 0.075,
    "reference_clip": 2.0
  },
  "q_learning": {
    "learning_rate": 0.1,
    "discount_factor": 0.9,
    "epsilon_start": 1.0,
    "epsilon_min": 0.05,
    "epsilon_decay_per_episode": 0.999,
    "initial_value": 0.05
  },
  "training": {
    "episodes": 5400,
    "seed": 42,
    "family_cycle": [
      "short_batch",
      "short_stream",
      "long_batch",
      "interactive",
      "interactive_sparse",
      "priority_aligned",
      "priority_skewed",
      "quantum_sensitive",
      "mixed"
    ]
  },
  "evaluation": {
    "repetitions": 10,
    "seed": 2024,
    "verification_repetitions": 25,
    "verification_seed": 777
  }
}