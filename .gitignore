# tracked.
results/study/explanations/
results/study/training_history.csv

# Legacy offline pipeline output (`python main.py experiment` with the default
# directories). It is byte-reproducible in about eight seconds from the declared seeds
# and is not part of the reported evidence, so it is generated on demand and not
# tracked. The evidence of the reported study lives in results/healing/, and the
# preserved secondary workflows keep their compact artifacts in results/study/ and
# results/runtime/.
